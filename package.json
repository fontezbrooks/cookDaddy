{
  "name": "cookdaddy",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@expo/ui": "~56.0.11",
    "@supabase/supabase-js": "^2.106.1",
    "expo": "~56.0.3",
    "expo-constants": "~56.0.14",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.8",
    "expo-linking": "~56.0.11",
    "expo-router": "~56.2.5",
    "expo-secure-store": "^56.0.3",
    "expo-splash-screen": "~56.0.9",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.1",
    "@types/react": "~19.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.36.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.0",
    "posthog-node": "^5.34.9",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.2.3",
    "svix": "^1.94.0",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "ingest": "tsx scripts/ingestion/import-spoon.ts",
    "ingest:backfill": "tsx scripts/ingestion/import-spoon.ts",
    "cron:install": "bash scripts/ingestion/setup-spoon-cron.sh",
    "cron:tick": "bash scripts/ingestion/cron-step.sh",
    "cron:health": "tail -200 \"$HOME/spoonacular-cron.log\" | grep -E 'tick (start|end)' | tail -50",
    "prepare": "husky"
  }
}
