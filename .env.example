# cookDaddy environment variables.
# Copy to .env (gitignored) and fill in. EXPO_PUBLIC_* are inlined into the app
# bundle and visible to anyone with the binary — never put server secrets here.

# --- Client-side (mobile app) ---
# Supabase URL + anon key. For local dev, point at the local supabase CLI stack
# (`pnpm db:start`); for cloud, use https://<ref>.supabase.co.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk publishable key (https://dashboard.clerk.com → API Keys).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# PostHog (https://app.posthog.com).
EXPO_PUBLIC_POSTHOG_KEY=

# Sentry (https://sentry.io).
EXPO_PUBLIC_SENTRY_DSN=

# --- Server-side (cron, scripts, Edge Functions — never bundled into the app) ---

# Clerk JWT issuer domain. Used by Supabase to validate Clerk-issued JWTs.
# Find at: Clerk Dashboard → JWT Templates → supabase → "Issuer".
CLERK_JWT_ISSUER_DOMAIN=

# Clerk webhook signing secret (Svix). Get from Clerk Dashboard → Webhooks
# → your webhook endpoint → "Signing secret" (starts with whsec_).
CLERK_WEBHOOK_SECRET=

# Supabase project ref — the slug in https://<ref>.supabase.co URLs.
SUPABASE_REF=

# Mirrors EXPO_PUBLIC_SUPABASE_URL but readable from non-Expo contexts (cron, CI).
SUPABASE_URL=

# Service role JWT — bypasses RLS. Used by import-spoon.ts and the clerk-user-webhook
# Edge Function. NEVER bundle into the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token for the supabase CLI (`supabase link`, `db push`).
# Generate at https://supabase.com/dashboard/account/tokens.
SUPABASE_ACCESS_TOKEN=

# Database password set when the cloud project was created. Needed for
# `supabase db push`. Reset at: Dashboard → Project Settings → Database.
SUPABASE_DB_PASSWORD=

# PostHog server-side key (used by the ingestion cron to emit recipe_apparent_duplicate).
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Spoonacular — used by scripts/ingestion/test-spoon.ps1 (P3).
SPOONACULAR_API_KEY=

# EAS project id — set in CI / EAS dashboard.
EAS_PROJECT_ID=
